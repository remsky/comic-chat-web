# Rules join rather than override, so paths must not overlap; immutable is only safe on the content-hashed names under /build and /art.

/build/*
  Cache-Control: public, max-age=31536000, immutable

/art/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=86400

/assets/help-icon.png
  Cache-Control: public, max-age=86400
