# Operator details substituted into the pages at build time. Copy to .env locally, or set the same names as Workers Builds variables. All optional.

# the address for takedown and privacy mail, and the contact the report page names; unset keeps neutral wording
LEGAL_CONTACT=
# the governing law clause, phrased to follow "the laws of"; unset keeps neutral wording
LEGAL_JURISDICTION=
# the titlebar coffee link; unset keeps the upstream author's, and any non-https value drops the button
SUPPORT_URL=
# this deployment's own origin; unset drops the canonical tags, social image, and sitemap
SITE_ORIGIN=
